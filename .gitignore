# Docker
.docker/
docker-compose.override.yml

# Generated answer key (run: scripts/answer-key.sh)
shared/pcaps/answer-key.txt

# SSL certs (regenerated by setup, but sslkeys.log needed for M16)
shared/certs/*.key
shared/certs/*.crt

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
opencode.json
__pycache__/
*.pyc

# Temp
*.tmp
*.bak
*~
*.log

# Local env overrides
*.env.local


# Dev/planning
0/
.env

# m16 TLS decryption (specific re-include after *.log)
!shared/certs/sslkeys.log

# Shark-Tank analiz raporları (üretim: ./scripts/shark-tank.sh <pcap|dizin>)
shared/pcaps/*.md

# Mini-CA malzemesi (üretim: ./shared/ca/generate-ca.sh)
shared/ca/
shared/pcaps/campaign.md
shared/pcaps/*.json

# MkDocs build artefaktı (site kullanımda değil; yanlışlıkla üretilirse repoya girmesin)
site/
