FROM alpine:3.21

RUN apk add --no-cache \
    curl \
    bind-tools \
    iputils \
    tcpdump \
    nmap \
    nmap-scripts \
    netcat-openbsd \
    iproute2 \
    bash \
    openssl \
    drill \
    sed \
    coreutils \
    python3 \
    py3-impacket \
    krb5 \
    samba-client \
    openldap-clients \
    cyrus-sasl-gssapiv2

RUN mkdir -p /etc/ldap && printf 'SASL_NOCANON on\nTLS_REQCERT never\n' > /etc/ldap/ldap.conf

WORKDIR /pcaps
CMD ["sleep", "infinity"]
